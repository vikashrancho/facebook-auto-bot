{
  "openapi": "3.1.0",
  "info": {
    "title": "Facebook Auto Bot API for ChatGPT",
    "version": "1.1.0",
    "description": "Secure machine-to-machine integration API enabling ChatGPT Custom GPT Actions to verify application readiness, stage generated Facebook photo posts for user review, enforce explicit human approval, and publish approved posts to the connected Facebook Page."
  },
  "servers": [
    {
      "url": "https://fbautopost.vetechno.in",
      "description": "Production server (Vercel)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "checkHealth",
        "summary": "Check application and Facebook Page readiness",
        "description": "Verifies that the application backend is operational, connected to the database, and has an active default Facebook Page configured.",
        "responses": {
          "200": {
            "description": "Application and Facebook Page are ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database or core services unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/images": {
      "post": {
        "operationId": "importChatGPTImage",
        "summary": "Import ChatGPT-generated or attached image into application storage",
        "description": "Imports an image already generated in the ChatGPT conversation (via DALL-E) or attached by the user. Accepts the file reference via openaiFileIdRefs, an approved HTTPS imageUrl, or base64 bytes. Downloads original image bytes and stores them permanently in Supabase Storage, returning a verified public HTTPS URL. Does NOT require any application-side image generation keys (OpenAI or Pexels). Does NOT generate new images or substitute missing images. This is the REQUIRED operation for the Custom GPT's normal post workflow after generating an image in chat.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportImageRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Image successfully ingested, verified, and hosted in Supabase Storage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportImageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid image format, unapproved host, SSRF blocked, or missing input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid Bearer API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/images/generate": {
      "post": {
        "operationId": "generateChatGPTImage",
        "summary": "Application-side image generation (uses app-configured AI provider)",
        "description": "Generates an image on the application server using the application's configured backend provider (DALL-E 3 or Pexels). Requires application-side API keys configured in application settings. The Custom GPT's normal post workflow must NOT call this operation because ChatGPT generates images directly in the chat using its built-in Image Generation tool.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateImageRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Image successfully generated, verified, and hosted in Supabase Storage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateImageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid prompt or bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid Bearer API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Image generation or storage failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/posts": {
      "post": {
        "operationId": "createChatGPTPost",
        "summary": "Stage an unpublished post draft for user review",
        "description": "Stages an unpublished Facebook post draft with content and hosted image URL. Pass the verified public URL returned by importChatGPTImage. Returns post ID and dashboard review URL. Always creates an unpublished draft; does not publish or schedule to Facebook.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePostRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Post staged successfully and awaiting explicit user review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePostResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, malformed image URL, or unapproved image host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid Bearer API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict — no default Facebook Page is configured in application settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/posts/{id}": {
      "get": {
        "operationId": "getChatGPTPost",
        "summary": "Get post details, status, content hash, and review URL",
        "description": "Retrieves authoritative post details, current publication status, destination Facebook Page, computed contentHash, and dashboard reviewUrl for a draft or published post record. Does not modify or publish the post. Use this Action to retrieve the contentHash and check post state before requesting approval.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Internal UUID of the post",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post details retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid Bearer API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Post not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/posts/{id}/approve": {
      "post": {
        "operationId": "approveChatGPTPost",
        "summary": "Explicitly approve a staged post for publishing",
        "description": "Must be invoked ONLY when the user explicitly approves publishing the post preview in conversation or requests approval. Validates that the provided contentHash matches the current staged copy and userConfirmed is true. Records user approval in the database and mints a short-lived, single-use approvalToken (10-minute expiry) required for publishChatGPTPost.",
        "x-openai-isConsequential": true,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Internal UUID of the staged post to approve",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovePostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post explicitly approved by user; returns short-lived single-use approval token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovePostResponse"
                }
              }
            }
          },
          "400": {
            "description": "User confirmation missing, content hash mismatch, or post already published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid Bearer API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Post not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict — destination Facebook Page is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/posts/{id}/publish": {
      "post": {
        "operationId": "publishChatGPTPost",
        "summary": "Publish an approved post to Facebook",
        "description": "Publishes an approved Facebook post using a valid single-use approval token. Use dryRun=true to simulate publication without posting to Facebook. Never bypass approval checks.",
        "x-openai-isConsequential": true,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Internal UUID of the post to publish",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishPostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post published to Facebook successfully or dry-run simulation completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishPostResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing approval token or invalid body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid Bearer API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — token is unapproved, expired, reused, forged, or content has been modified since approval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Post not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict — uncertain timeout recovery blocked without forceRetry, or post currently publishing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway — Meta Graph API rejected the publication request or failed to publish",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token matching the INTEGRATION_API_KEY environment variable configured on the server."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "database", "facebookPageConfigured"],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "database": {
            "type": "string",
            "example": "ok"
          },
          "facebookPageConfigured": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ImportImageRequest": {
        "type": "object",
        "properties": {
          "openaiFileIdRefs": {
            "type": "array",
            "description": "Attached image files from ChatGPT (DALL-E generated or user-uploaded). Accepts up to 1 image file. At runtime, each element is a JSON object with name, id, mime_type, and download_link. The backend immediately downloads the original bytes and hosts them in Supabase Storage without modification. Only JPEG, PNG, and WebP images are supported.",
            "items": {
              "type": "string"
            }
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "HTTPS URL of the image from an approved host (e.g. OpenAI, Azure blob, Pexels, Unsplash, Supabase). Safe redirects are supported.",
            "example": "https://files.oaiusercontent.com/file-sample.png"
          },
          "imageBase64": {
            "type": "string",
            "description": "Raw base64-encoded image string or data URI (PNG, JPEG, or WebP)."
          }
        }
      },
      "GenerateImageRequest": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500,
            "description": "Topic description for server-side image generation when the user does not supply an image.",
            "example": "Professional photography of modern workspace with laptop and coffee"
          }
        }
      },
      "GenerateImageResponse": {
        "type": "object",
        "required": ["url", "verified", "source"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Verified permanent Supabase Storage public HTTPS URL hosting the generated image.",
            "example": "https://dlzttvnwhiygnlumkbvg.supabase.co/storage/v1/object/public/post-images/chatgpt/2026-10-16/uuid.jpg"
          },
          "verified": {
            "type": "boolean",
            "example": true
          },
          "source": {
            "type": "string",
            "enum": ["ai", "stock"],
            "example": "ai"
          },
          "message": {
            "type": "string",
            "example": "Image generated, verified, and hosted in Supabase Storage."
          }
        }
      },
      "ImportImageResponse": {
        "type": "object",
        "required": ["url", "verified", "source"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Verified permanent Supabase Storage public HTTPS URL.",
            "example": "https://dlzttvnwhiygnlumkbvg.supabase.co/storage/v1/object/public/post-images/chatgpt/2026-10-16/uuid.jpg"
          },
          "verified": {
            "type": "boolean",
            "example": true
          },
          "source": {
            "type": "string",
            "enum": ["import", "upload", "ai"],
            "example": "import"
          },
          "sha256": {
            "type": "string",
            "description": "SHA-256 hash of the stored image bytes, verifying exact byte preservation.",
            "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
          },
          "fileName": {
            "type": "string",
            "example": "attachment.png"
          },
          "mimeType": {
            "type": "string",
            "example": "image/png"
          },
          "byteLength": {
            "type": "integer",
            "example": 204800
          },
          "message": {
            "type": "string",
            "example": "Attached image successfully verified, hosted in Supabase Storage, and exact bytes preserved."
          }
        }
      },
      "CreatePostRequest": {
        "type": "object",
        "required": ["title", "description"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Opening hook for the Facebook post.",
            "example": "5 Morning Habits That Double Your Focus"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Engaging caption body ending with a question.",
            "example": "Starting your day without your phone can transform your productivity. Which habit has made the biggest difference in your routine?"
          },
          "hashtags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 15,
            "description": "Relevant hashtags without # symbols.",
            "example": ["ProductivityTips", "MorningRoutine", "Focus"]
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "minLength": 1,
            "description": "Verified public HTTPS URL of the hosted image in Supabase Storage (returned by importChatGPTImage or generateChatGPTImage) or an approved external HTTPS host.",
            "example": "https://dlzttvnwhiygnlumkbvg.supabase.co/storage/v1/object/public/post-images/chatgpt/2026-10-16/uuid.jpg"
          },
          "openaiFileIdRefs": {
            "type": "array",
            "description": "Attached image files from ChatGPT (DALL-E generated or user-uploaded). At runtime, each element is a JSON object with name, id, mime_type, and download_link.",
            "items": {
              "type": "string"
            }
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Unique client-generated key to prevent duplicate post creation on retries.",
            "example": "chatgpt_req_8f7b2c1e"
          }
        }
      },
      "CreatePostResponse": {
        "type": "object",
        "required": [
          "postId",
          "status",
          "title",
          "description",
          "hashtags",
          "imageUrl",
          "pageName",
          "contentHash",
          "reviewUrl",
          "approvalRequired",
          "message"
        ],
        "properties": {
          "postId": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "status": {
            "type": "string",
            "example": "pending_review"
          },
          "title": {
            "type": "string",
            "example": "5 Morning Habits That Double Your Focus"
          },
          "description": {
            "type": "string",
            "example": "Starting your day without your phone can transform your productivity."
          },
          "hashtags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["ProductivityTips", "Focus"]
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "Permanent Supabase Storage URL hosting the ingested image.",
            "example": "https://xyz.supabase.co/storage/v1/object/public/post-images/chatgpt/2026-10-16/uuid.png"
          },
          "pageName": {
            "type": "string",
            "description": "Name of the target Facebook Page where content will be published.",
            "example": "My Tech Brand"
          },
          "contentHash": {
            "type": "string",
            "description": "Deterministic SHA-256 hash of post copy, image, and target Page. Must be supplied when requesting approval.",
            "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
          },
          "approvalRequired": {
            "type": "boolean",
            "example": true
          },
          "reviewUrl": {
            "type": "string",
            "description": "Authenticated dashboard URL where the human owner can directly review and inspect the staged post.",
            "example": "/dashboard/queue?post=3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "message": {
            "type": "string",
            "example": "Post staged and awaiting explicit user review. Display preview to user. When approved, call POST /api/chatgpt/posts/{id}/approve."
          }
        }
      },
      "ApprovePostRequest": {
        "type": "object",
        "required": ["userConfirmed", "contentHash"],
        "properties": {
          "userConfirmed": {
            "type": "boolean",
            "description": "Must be true, certifying that the user has reviewed and explicitly approved the staged post in chat.",
            "example": true
          },
          "contentHash": {
            "type": "string",
            "description": "The exact contentHash returned when the post was staged.",
            "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
          }
        }
      },
      "ApprovePostResponse": {
        "type": "object",
        "required": ["approved", "postId", "contentHash", "approvalToken", "expiresAt", "reviewUrl", "message"],
        "properties": {
          "approved": {
            "type": "boolean",
            "example": true
          },
          "postId": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "contentHash": {
            "type": "string",
            "description": "The verified content hash that this approval and approvalToken bind to.",
            "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
          },
          "approvalToken": {
            "type": "string",
            "description": "Single-use cryptographic token required by POST /api/chatgpt/posts/{id}/publish.",
            "example": "eyJhbGciOi...base64url_token"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-16T10:40:00.000Z"
          },
          "reviewUrl": {
            "type": "string",
            "description": "Authenticated dashboard URL for the post.",
            "example": "/dashboard/queue?post=3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "message": {
            "type": "string",
            "example": "Post explicitly approved by user. You may now call POST /api/chatgpt/posts/{id}/publish with this single-use approvalToken before it expires (10 minutes)."
          }
        }
      },
      "PublishPostRequest": {
        "type": "object",
        "required": ["approvalToken"],
        "properties": {
          "approvalToken": {
            "type": "string",
            "description": "Single-use approvalToken minted by POST /api/chatgpt/posts/{id}/approve.",
            "example": "eyJhbGciOi...base64url_token"
          },
          "dryRun": {
            "type": "boolean",
            "description": "When true, validates all prerequisites and simulates publication without modifying the database or calling Meta Graph API.",
            "example": false
          },
          "forceRetry": {
            "type": "boolean",
            "description": "Set to true only after human inspection confirms that a post previously failing with an [UNCERTAIN_OUTCOME] does not exist on Facebook.",
            "example": false
          }
        }
      },
      "PublishPostResponse": {
        "type": "object",
        "required": ["success", "postId", "status"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "simulated": {
            "type": "boolean",
            "description": "Present and true only when dryRun=true was requested.",
            "example": false
          },
          "postId": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "scheduled", "publishing", "posted", "failed"],
            "example": "posted"
          },
          "title": {
            "type": "string",
            "description": "Title/hook of the post.",
            "example": "5 Morning Habits That Double Your Focus"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "The exact permanent Supabase Storage URL hosting the published image. Use this URL for post-publication display.",
            "example": "https://dlzttvnwhiygnlumkbvg.supabase.co/storage/v1/object/public/post-images/chatgpt/2026-10-16/uuid.jpg"
          },
          "facebookPostId": {
            "type": "string",
            "description": "Meta Graph API post ID (PageID_PostID) for real publications.",
            "example": "100200300400500_600700800900"
          },
          "facebookPostUrl": {
            "type": "string",
            "format": "uri",
            "description": "Public link to the published Facebook post.",
            "example": "https://www.facebook.com/100200300400500_600700800900"
          },
          "simulatedFacebookPostId": {
            "type": "string",
            "description": "Simulated post identifier returned only during dry-run.",
            "example": "simulated_dryrun_3fa85f64"
          },
          "simulatedFacebookPostUrl": {
            "type": "string",
            "format": "uri",
            "description": "Simulated post URL returned only during dry-run.",
            "example": "https://facebook.com/simulated_dryrun_3fa85f64"
          },
          "postedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-16T10:30:00.000Z"
          },
          "message": {
            "type": "string",
            "example": "Dry-run simulation succeeded or post published."
          }
        }
      },
      "PostStatusResponse": {
        "type": "object",
        "required": [
          "postId",
          "status",
          "title",
          "description",
          "imageUrl",
          "contentHash",
          "reviewUrl",
          "approvedByUser"
        ],
        "properties": {
          "postId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "example": "pending_review"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "hashtags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "pageName": {
            "type": "string",
            "nullable": true
          },
          "contentHash": {
            "type": "string",
            "description": "Authoritative SHA-256 hash of the current post content and destination Page. Must be supplied to approveChatGPTPost when approving.",
            "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
          },
          "reviewUrl": {
            "type": "string",
            "description": "Authenticated dashboard URL for human review of this post.",
            "example": "/dashboard/queue?post=3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "approvedByUser": {
            "type": "boolean",
            "description": "Indicates whether this post has already received explicit user approval."
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "isContentUnchangedSinceApproval": {
            "type": "boolean",
            "description": "True if the post content matches the content hash recorded when approved."
          },
          "facebookPostId": {
            "type": "string",
            "nullable": true
          },
          "facebookPostUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "postedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "example": "Unauthorized."
          }
        }
      }
    }
  }
}
